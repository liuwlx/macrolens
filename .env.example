# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEMO_MODE=false

# PostgreSQL
POSTGRES_DB=macrolens
POSTGRES_USER=macrolens
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://macrolens:change-me@postgres:5432/macrolens
DATABASE_URL_SYNC=postgresql+psycopg://macrolens:change-me@postgres:5432/macrolens

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
ALLOW_PUBLIC_REGISTRATION=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# Object storage (S3 / R2 / MinIO)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=macrolens
S3_SECRET_ACCESS_KEY=change-me-minio
S3_BUCKET=macrolens
S3_REGION=auto
S3_PUBLIC_BASE_URL=http://localhost:9000/macrolens

# Official data APIs
FRED_API_KEY=
BEA_API_KEY=
BLS_API_KEY=
EIA_API_KEY=
CENSUS_API_KEY=
DOL_CLAIMS_URL=
FEDERAL_RESERVE_CALENDAR_URL=https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm
BLS_RELEASE_CALENDAR_URL=https://www.bls.gov/schedule/news_release/bls.ics

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_DEEP_RESEARCH_MODEL=gpt-5.6
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_STORE=false

# Worker
WORKER_ID=worker-local
WORKER_POLL_SECONDS=2
WORKER_CONCURRENCY=4
WORKER_JOB_LOCK_SECONDS=900

# Email (optional)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=MacroLens <noreply@example.com>
SMTP_USE_TLS=false
